<!-- EzRealmSync 独立仓库：默认 ez2lazer.Game NuGet；lib/ 仅本地开发覆盖。包版本见 Directory.Packages.props。 -->
<Project>
  <Import Project="$(MSBuildThisFileDirectory)EzRealmSync.LocalLibs.props" Condition="Exists('$(MSBuildThisFileDirectory)EzRealmSync.LocalLibs.props')"/>

  <PropertyGroup Label="EzRealmSync">
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest Condition="'$(OutputType)' == 'WinExe'">$(MSBuildThisFileDirectory)app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <PackageProjectUrl>https://github.com/Ez2Lazer/EzRealmSync</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Ez2Lazer/EzRealmSync</RepositoryUrl>
    <PackageTags>osu ez2lazer realm sync</PackageTags>
  </PropertyGroup>

  <!-- ez2lazer.Game 会传递带入 Game.Resources；本工具不需要皮肤/字体资源，全局压掉。 -->
  <ItemGroup>
    <PackageReference Include="ez2lazer.Game.Resources">
      <ExcludeAssets>all</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Resources\**\*.*"/>
  </ItemGroup>
</Project>
