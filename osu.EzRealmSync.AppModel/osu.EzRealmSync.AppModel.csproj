<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>osu.EzRealmSync.AppModel</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\osu.Game.EzRealmSync\osu.Game.EzRealmSync.csproj">
      <AdditionalProperties>UseLocalOsuLibs=$(UseLocalOsuLibs)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx" />
    <EmbeddedResource Update="Localization\Strings.zh-Hans.resx" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只认 osu.Framework（Bindables/WinForms 宿主）；typed 游戏包不再引入，
         否则 osu.Game.dll 会被打进输出，只能靠 prune-publish 事后硬删。 -->
    <PackageReference Include="ez2lazer.Framework" />
  </ItemGroup>
</Project>
