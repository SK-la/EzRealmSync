<ui:FluentWindow x:Class="osu.EzRealmSync.Desktop.FolderPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Select folder"
                 Width="640"
                 Height="480"
                 MinWidth="480"
                 MinHeight="360"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 Background="Transparent"
                 WindowBackdropType="Acrylic"
                 ExtendsContentIntoTitleBar="True">
  <Grid Margin="0,0,0,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" x:Name="PickerTitleBar" Margin="6,6,6,0" />

    <ui:TextBox x:Name="PathBox"
                Grid.Row="1"
                Margin="16,8,16,8"
                IsReadOnly="True"
                Icon="{ui:SymbolIcon Folder24}" />

    <ui:ListView x:Name="FolderList"
                 Grid.Row="2"
                 Margin="16,0,16,8"
                 MouseDoubleClick="FolderList_OnMouseDoubleClick" />

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="16,0,16,0">
      <ui:Button x:Name="UpButton" Margin="0,0,8,0" Click="UpButton_OnClick" />
      <ui:Button x:Name="CancelButton" Margin="0,0,8,0" Click="CancelButton_OnClick" />
      <ui:Button x:Name="SelectButton" Appearance="Primary" Click="SelectButton_OnClick" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
