<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>osu.EzRealmSync.Desktop</RootNamespace>
    <AssemblyName>EzRealmSync</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>osu.EzRealmSync.Desktop.Program</StartupObject>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\osu.EzRealmSync.AppModel\osu.EzRealmSync.AppModel.csproj" />
    <ProjectReference Include="..\osu.Game.EzRealmSync\osu.Game.EzRealmSync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只保留 osu.Framework（RealmAppPresenter / ShellViewModel 用 Bindables）：
         产品进程不加载 osu.Game.dll，见 docs/DATA-OPERATIONS.zh.md。 -->
    <PackageReference Include="ez2lazer.Framework" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="WPF-UI.Abstractions" />
    <PackageReference Include="WPF-UI.DependencyInjection" />
    <PackageReference Include="WPF-UI.Markdown" />
    <PackageReference Include="WPF-UI.Tray" />
    <PackageReference Include="WPF-UI.Violeta" />
  </ItemGroup>
</Project>
