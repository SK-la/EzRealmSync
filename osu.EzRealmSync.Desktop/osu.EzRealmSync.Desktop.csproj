<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>osu.EzRealmSync.Desktop</RootNamespace>
    <AssemblyName>EzRealmSync</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>osu.EzRealmSync.Desktop.Program</StartupObject>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <UseLocalOsuLibs Condition="'$(UseLocalOsuLibs)' != 'true' and '$(UseLocalOsuLibs)' != 'false' and Exists('$(EzRealmSyncLibDir)\osu.Game.dll')">true</UseLocalOsuLibs>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\osu.EzRealmSync.AppModel\osu.EzRealmSync.AppModel.csproj" />
    <ProjectReference Include="..\osu.Game.EzRealmSync\osu.Game.EzRealmSync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ez2lazer.Framework" Version="2026.616.0-ez2lazer" />
    <PackageReference Include="ez2lazer.Game" Version="2026.605.0-ez2lazer" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Abstractions" Version="4.3.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Markdown" Version="4.0.2" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Violeta" Version="4.3.0" />
  </ItemGroup>
</Project>
