<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>osu.EzRealmSync.Desktop</RootNamespace>
    <AssemblyName>EzRealmSync</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>osu.EzRealmSync.Desktop.Program</StartupObject>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\osu.EzRealmSync.AppModel\osu.EzRealmSync.AppModel.csproj" />
    <ProjectReference Include="..\osu.Game.EzRealmSync\osu.Game.EzRealmSync.csproj" />
    <ProjectReference Include="..\osu.Game.EzRealmSync.OfficialWrite\osu.Game.EzRealmSync.OfficialWrite.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\osu.Game.EzRealmSync.ReadSidecar\osu.Game.EzRealmSync.ReadSidecar.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ez2lazer.Framework" />
    <PackageReference Include="ez2lazer.Game" />
    <PackageReference Include="ez2lazer.Game.Resources">
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="WPF-UI.Abstractions" />
    <PackageReference Include="WPF-UI.DependencyInjection" />
    <PackageReference Include="WPF-UI.Markdown" />
    <PackageReference Include="WPF-UI.Tray" />
    <PackageReference Include="WPF-UI.Violeta" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\readers\**\*"
             Exclude="..\readers\**\lib\*.dll;..\readers\**\lib\**\*.dll;..\readers\**\lib\runtimes\**\*.*">
      <Link>readers\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\scripts\Sync-ReaderLibs.ps1">
      <Link>scripts\Sync-ReaderLibs.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\scripts\Sync-ReaderLibs.cmd">
      <Link>scripts\Sync-ReaderLibs.cmd</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
