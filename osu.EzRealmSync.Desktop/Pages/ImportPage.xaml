<UserControl x:Class="osu.EzRealmSync.Desktop.Pages.ImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <Grid Margin="4" VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
    </Grid.RowDefinitions>

    <ui:Card x:Name="DropZone"
             Grid.Row="0"
             Margin="0,0,0,12"
             MinHeight="96"
             Padding="32,24"
             AllowDrop="True"
             Cursor="Hand">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="ArrowDownload24"
                       FontSize="28"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"
                       Opacity="0.85" />
        <ui:TextBlock x:Name="DropHintText"
                      Style="{StaticResource WorkspaceMutedText}"
                      HorizontalAlignment="Center"
                      TextWrapping="Wrap"
                      TextAlignment="Center"
                      LineHeight="22" />
      </StackPanel>
    </ui:Card>

    <ui:Card Grid.Row="1" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock x:Name="SearchDirLabel"
                        Style="{StaticResource WorkspaceMutedText}"
                        VerticalAlignment="Center" />
          <ui:TextBox x:Name="SearchDirBox"
                      Grid.Column="1"
                      Margin="8,0"
                      MinHeight="36"
                      VerticalContentAlignment="Center"
                      Icon="{ui:SymbolIcon Folder24}" />
          <ui:Button x:Name="BrowseSearchButton"
                     Grid.Column="2"
                     MinHeight="36"
                     Click="BrowseSearch_OnClick"
                     Icon="{ui:SymbolIcon Folder24}" />
          <ui:Button x:Name="ApplySearchButton"
                     Grid.Column="4"
                     MinHeight="36"
                     Click="ApplySearch_OnClick" />
        </Grid>
        <ui:Button x:Name="RefreshButton"
                   Grid.Row="2"
                   MinHeight="36"
                   HorizontalAlignment="Left"
                   Click="Refresh_OnClick"
                   Icon="{ui:SymbolIcon ArrowSync24}" />
      </Grid>
    </ui:Card>

    <ui:Card Grid.Row="2" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock x:Name="BackupDirLabel"
                        Style="{StaticResource WorkspaceMutedText}"
                        VerticalAlignment="Center" />
          <ui:TextBox x:Name="BackupDirBox"
                      Grid.Column="1"
                      Margin="8,0"
                      MinHeight="36"
                      VerticalContentAlignment="Center"
                      Icon="{ui:SymbolIcon Archive24}" />
          <ui:Button x:Name="BrowseBackupButton"
                     Grid.Column="2"
                     MinHeight="36"
                     Click="BrowseBackup_OnClick" />
          <ui:Button x:Name="BackupButton"
                     Grid.Column="4"
                     MinHeight="36"
                     Click="Backup_OnClick" />
        </Grid>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock x:Name="BackupListLabel"
                        Style="{StaticResource WorkspaceMutedText}"
                        VerticalAlignment="Center" />
          <ComboBox x:Name="BackupCombo"
                    Grid.Column="1"
                    MinHeight="36"
                    VerticalContentAlignment="Center"
                    DisplayMemberPath="DisplayText"
                    SelectedValuePath="Id" />
          <ui:Button x:Name="RefreshBackupsButton"
                     Grid.Column="3"
                     MinHeight="36"
                     Click="RefreshBackups_OnClick"
                     Icon="{ui:SymbolIcon ArrowSync24}" />
          <ui:Button x:Name="RestoreBackupButton"
                     Grid.Column="5"
                     MinHeight="36"
                     Click="RestoreBackup_OnClick"
                     Icon="{ui:SymbolIcon History24}" />
        </Grid>
      </Grid>
    </ui:Card>

    <ui:Card Grid.Row="3"
             Style="{StaticResource WorkspaceStretchCard}"
             Padding="12">
      <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TextBlock x:Name="RealmListTitle"
                      Grid.Row="0"
                      Style="{StaticResource WorkspaceBodyText}"
                      FontWeight="SemiBold"
                      Margin="0,0,0,8"
                      LineHeight="20" />
        <ui:DataGrid x:Name="RealmFilesGrid"
                     Grid.Row="1"
                     Style="{StaticResource WorkspaceStretchDataGrid}"
                     RowHeight="32"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     IsReadOnly="True"
                     SelectionMode="Extended"
                     SelectionUnit="FullRow"
                     ClipboardCopyMode="None"
                     SelectionChanged="RealmFilesGrid_OnSelectionChanged" />
      </Grid>
    </ui:Card>
  </Grid>
</UserControl>
