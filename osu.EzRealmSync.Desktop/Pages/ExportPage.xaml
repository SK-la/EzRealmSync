<UserControl x:Class="osu.EzRealmSync.Desktop.Pages.ExportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <Grid Margin="4" VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
    </Grid.RowDefinitions>

    <ui:TextBlock x:Name="HintText"
                  Grid.Row="0"
                  Style="{StaticResource WorkspaceMutedText}"
                  Margin="4,0,4,10"
                  TextWrapping="Wrap" />

    <ui:Card Grid.Row="1" Padding="14" Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="RealmSelectCombo"
                    MinHeight="36"
                    VerticalContentAlignment="Center"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="Id"
                    SelectionChanged="RealmSelectCombo_OnChanged" />
          <ComboBox x:Name="DataKindCombo"
                    Grid.Column="2"
                    MinHeight="36"
                    VerticalContentAlignment="Center"
                    SelectionChanged="DataKindCombo_OnChanged" />
          <ui:Button x:Name="LoadListButton"
                     Grid.Column="4"
                     MinHeight="36"
                     Click="LoadList_OnClick"
                     Appearance="Primary"
                     Icon="{ui:SymbolIcon List24}" />
        </Grid>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock x:Name="ExportDirLabel"
                        Style="{StaticResource WorkspaceMutedText}"
                        VerticalAlignment="Center" />
          <ui:TextBox x:Name="ExportDirBox"
                      Grid.Column="1"
                      Margin="8,0"
                      MinHeight="36"
                      VerticalContentAlignment="Center"
                      Icon="{ui:SymbolIcon Folder24}" />
          <ui:Button x:Name="BrowseExportButton"
                     Grid.Column="2"
                     MinHeight="36"
                     Click="BrowseExport_OnClick"
                     Icon="{ui:SymbolIcon Folder24}" />
          <ui:TextBox x:Name="FolderNameBox"
                      Grid.Column="4"
                      MinHeight="36"
                      VerticalContentAlignment="Center" />
          <ui:Button x:Name="ExportButton"
                     Grid.Column="6"
                     MinHeight="36"
                     Click="Export_OnClick"
                     Appearance="Primary"
                     Icon="{ui:SymbolIcon ArrowExport24}" />
        </Grid>
      </Grid>
    </ui:Card>

    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
      <ui:Button x:Name="SelectAllButton" Margin="0,0,8,0" Click="SelectAll_OnClick" />
    </WrapPanel>

    <ui:Card Grid.Row="3"
             Style="{StaticResource WorkspaceStretchCard}"
             Padding="8">
      <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:DataGrid x:Name="ExportGrid"
                     Grid.Row="0"
                     Style="{StaticResource WorkspaceStretchDataGrid}"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     SelectionMode="Extended" />
      </Grid>
    </ui:Card>
  </Grid>
</UserControl>
