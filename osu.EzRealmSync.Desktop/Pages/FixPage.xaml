<UserControl x:Class="osu.EzRealmSync.Desktop.Pages.FixPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <Grid Margin="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="240" />
    </Grid.RowDefinitions>

    <ui:TextBlock x:Name="HintText"
                  Grid.Row="0"
                  Margin="4,0,4,10"
                  TextWrapping="Wrap"
                  Opacity="0.75" />

    <ui:Card Grid.Row="1" Padding="14" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="RealmSelectCombo"
                  MinHeight="36"
                  VerticalContentAlignment="Center"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Id"
                  SelectionChanged="RealmSelectCombo_OnChanged" />
        <ui:TextBlock x:Name="ReplacementLabel"
                      Grid.Column="1"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Opacity="0.75" />
        <ui:TextBox x:Name="ReplacementBox"
                    Grid.Column="3"
                    MinHeight="36"
                    MaxLength="1"
                    VerticalContentAlignment="Center" />
        <ui:Button x:Name="ScanButton"
                   Grid.Column="5"
                   MinHeight="36"
                   Click="Scan_OnClick"
                   Appearance="Primary"
                   Icon="{ui:SymbolIcon Search24}" />
        <ui:Button x:Name="FixSelectedButton"
                   Grid.Column="7"
                   MinHeight="36"
                   Click="FixSelected_OnClick"
                   Icon="{ui:SymbolIcon Wrench24}" />
        <ui:Button x:Name="FixAllButton"
                   Grid.Column="9"
                   MinHeight="36"
                   Click="FixAll_OnClick"
                   Icon="{ui:SymbolIcon Checkmark24}" />
      </Grid>
    </ui:Card>

    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
      <ui:Button x:Name="SelectAllButton" Margin="0,0,8,0" Click="SelectAll_OnClick" />
    </WrapPanel>

    <ui:Card Grid.Row="3" Padding="8">
      <ui:DataGrid x:Name="IssuesGrid"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   MinHeight="200"
                   AutoGenerateColumns="False"
                   CanUserAddRows="False"
                   CanUserDeleteRows="False"
                   SelectionMode="Extended" />
    </ui:Card>
  </Grid>
</UserControl>
