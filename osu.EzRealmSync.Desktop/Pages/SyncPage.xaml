<UserControl x:Class="osu.EzRealmSync.Desktop.Pages.SyncPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <Grid Margin="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="240" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:Card Grid.Row="0" Padding="14" Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="96" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="96" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:TextBlock x:Name="SourceLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Opacity="0.75" />
        <ComboBox x:Name="SourceCombo" Grid.Row="0" Grid.Column="1" Margin="8,4" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="SourceCombo_OnChanged" />
        <ui:TextBlock x:Name="TargetLabel" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Opacity="0.75" />
        <ComboBox x:Name="TargetCombo" Grid.Row="0" Grid.Column="3" Margin="8,4" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="TargetCombo_OnChanged" />

        <ui:TextBlock x:Name="SetOpLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Opacity="0.75" />
        <ComboBox x:Name="SetOpCombo" Grid.Row="1" Grid.Column="1" Margin="8,4" SelectionChanged="SetOpCombo_OnChanged" />
        <ui:TextBlock x:Name="ActionLabel" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Opacity="0.75" />
        <ComboBox x:Name="ActionCombo" Grid.Row="1" Grid.Column="3" Margin="8,4" SelectionChanged="ActionCombo_OnChanged" />
      </Grid>
    </ui:Card>

    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
      <ui:Button x:Name="ComputeButton" Margin="0,0,8,6" Click="Compute_OnClick" Appearance="Primary" Icon="{ui:SymbolIcon Calculator24}" />
      <ui:Button x:Name="TabSourceOnly" Margin="0,0,8,6" Click="TabSourceOnly_OnClick" />
      <ui:Button x:Name="TabTargetOnly" Margin="0,0,8,6" Click="TabTargetOnly_OnClick" />
      <ui:Button x:Name="TabConflicted" Margin="0,0,8,6" Click="TabConflicted_OnClick" />
      <ui:Button x:Name="SelectAllButton" Margin="0,0,8,6" Click="SelectAll_OnClick" />
      <ComboBox x:Name="EntityFilterCombo" Width="148" Margin="0,0,0,6" SelectionChanged="EntityFilter_OnChanged" />
    </WrapPanel>

    <ui:Card Grid.Row="2" Padding="8" Margin="0,0,0,10">
      <ui:DataGrid x:Name="SyncGrid"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   MinHeight="200"
                   AutoGenerateColumns="False"
                   CanUserAddRows="False"
                   CanUserDeleteRows="False"
                   SelectionMode="Extended"
                   CurrentCellChanged="SyncGrid_OnCellChanged" />
    </ui:Card>

    <ui:Card Grid.Row="3" Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock x:Name="SelectionText" VerticalAlignment="Center" Opacity="0.75" />
        <ui:Button x:Name="ExecuteButton" Grid.Column="1" Margin="8,0" Click="Execute_OnClick" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" />
      </Grid>
    </ui:Card>
  </Grid>
</UserControl>
