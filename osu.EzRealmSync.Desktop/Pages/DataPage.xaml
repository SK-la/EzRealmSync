<UserControl x:Class="osu.EzRealmSync.Desktop.Pages.DataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <Grid Margin="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="240" />
    </Grid.RowDefinitions>

    <ui:Card Grid.Row="0" Padding="14" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="RealmSelectCombo"
                  MinWidth="280"
                  MinHeight="36"
                  VerticalContentAlignment="Center"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Id"
                  SelectionChanged="RealmSelectCombo_OnChanged" />
        <ui:Button x:Name="LoadButton"
                   Grid.Column="1"
                   Margin="12,0,0,0"
                   MinHeight="36"
                   Click="Load_OnClick"
                   Appearance="Primary"
                   Icon="{ui:SymbolIcon Database24}" />
      </Grid>
    </ui:Card>

    <ui:TextBlock x:Name="SummaryText"
                  Grid.Row="1"
                  Margin="4,0,4,8"
                  Opacity="0.75"
                  TextWrapping="Wrap" />

    <WrapPanel x:Name="GroupTabBar" Grid.Row="2" Margin="0,0,0,10">
      <ui:Button x:Name="GroupTabBeatmapSet" Margin="0,0,8,0" Click="GroupTab_OnClick" Tag="BeatmapSet" />
      <ui:Button x:Name="GroupTabBeatmap" Margin="0,0,8,0" Click="GroupTab_OnClick" Tag="Beatmap" />
      <ui:Button x:Name="GroupTabScore" Margin="0,0,8,0" Click="GroupTab_OnClick" Tag="Score" />
    </WrapPanel>

    <ui:Card Grid.Row="3" Padding="8">
      <ui:DataGrid x:Name="DataGrid"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   MinHeight="200"
                   AutoGenerateColumns="False"
                   CanUserAddRows="False"
                   CanUserDeleteRows="False"
                   SelectionMode="Extended" />
    </ui:Card>
  </Grid>
</UserControl>
