<ui:FluentWindow x:Class="osu.EzRealmSync.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:osu.EzRealmSync.Desktop.Pages"
                 Title="Ez Realm Sync"
                 Width="1320"
                 Height="800"
                 MinWidth="1024"
                 MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 Background="Transparent"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" MinHeight="64" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" x:Name="MainTitleBar" Margin="8,6,8,0" />

    <ui:NavigationView x:Name="WorkspaceNav"
                     Grid.Row="1"
                     Margin="8,4,8,4"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     PaneDisplayMode="Top"
                     IsBackButtonVisible="Collapsed"
                     IsPaneToggleVisible="False"
                     OpenPaneLength="0"
                     SelectionChanged="WorkspaceNav_OnSelectionChanged">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem x:Name="NavImport"
                               Tag="Import"
                               TargetPageType="{x:Type pages:ImportPage}"
                               Icon="{ui:SymbolIcon ArrowDownload24}" />
        <ui:NavigationViewItem x:Name="NavData"
                               Tag="Data"
                               TargetPageType="{x:Type pages:DataPage}"
                               Icon="{ui:SymbolIcon Database24}" />
        <ui:NavigationViewItem x:Name="NavSync"
                               Tag="Sync"
                               TargetPageType="{x:Type pages:SyncPage}"
                               Icon="{ui:SymbolIcon ArrowSync24}" />
        <ui:NavigationViewItem x:Name="NavFix"
                               Tag="Fix"
                               TargetPageType="{x:Type pages:FixPage}"
                               Icon="{ui:SymbolIcon Wrench24}" />
        <ui:NavigationViewItem x:Name="NavExport"
                               Tag="Export"
                               TargetPageType="{x:Type pages:ExportPage}"
                               Icon="{ui:SymbolIcon ArrowExport24}" />
      </ui:NavigationView.MenuItems>
    </ui:NavigationView>

    <ui:ContentDialogHost x:Name="RootContentDialogHost"
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          Panel.ZIndex="20"
                          IsHitTestVisible="False" />
    <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="0,0,12,88"
                          Panel.ZIndex="30"
                          IsHitTestVisible="False" />

    <ui:Card Grid.Row="2" Margin="12,0,12,10" Padding="12,10" Panel.ZIndex="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" MinWidth="0" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:ProgressRing x:Name="StatusProgressRing"
                         Grid.Column="0"
                         Width="28"
                         Height="28"
                         VerticalAlignment="Center"
                         IsIndeterminate="False" />
        <ScrollViewer x:Name="StatusScrollViewer"
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="80"
                      MouseLeftButtonUp="StatusScrollViewer_OnMouseLeftButtonUp">
          <ui:TextBlock x:Name="StatusText"
                        TextWrapping="Wrap"
                        LineHeight="20"
                        Opacity="0.85" />
        </ScrollViewer>
        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <ui:TextBlock x:Name="LanguageLabel"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        LineHeight="20"
                        Opacity="0.75" />
          <ComboBox x:Name="LanguageCombo"
                    MinWidth="128"
                    MaxWidth="160"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    SelectionChanged="LanguageCombo_OnChanged" />
        </StackPanel>
        <ui:Button x:Name="SettingsButton"
                   Grid.Column="5"
                   MinHeight="32"
                   VerticalAlignment="Center"
                   Appearance="Secondary"
                   Icon="{ui:SymbolIcon Settings24}"
                   Click="SettingsButton_OnClick" />
        <Popup x:Name="SettingsPopup"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="False"
               PopupAnimation="Fade">
          <ui:Card Padding="12"
                   MinWidth="320"
                   MaxWidth="360"
                   Background="{StaticResource EzBrushBgSettingsFlyout}">
            <ScrollViewer MaxHeight="440"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <ui:CardExpander x:Name="GeneralSettingsExpander"
                                IsExpanded="True"
                                Icon="{ui:SymbolIcon Info24}">
                  <StackPanel>
                    <ui:ToggleSwitch x:Name="UiTestModeSwitch"
                                     Margin="0,0,0,8"
                                     LabelPosition="Right"
                                     Click="UiTestModeSwitch_OnClick" />
                    <ui:TextBlock x:Name="UiTestHint"
                                  TextWrapping="Wrap"
                                  Style="{StaticResource WorkspaceMutedText}" />
                    <ui:ToggleSwitch x:Name="ConfirmDeleteSwitch"
                                     Margin="0,12,0,0"
                                     LabelPosition="Right"
                                     Click="ConfirmDeleteSwitch_OnClick" />
                    <ui:TextBlock x:Name="ConfirmDeleteHint"
                                  Margin="0,4,0,0"
                                  TextWrapping="Wrap"
                                  Style="{StaticResource WorkspaceMutedText}" />
                  </StackPanel>
                </ui:CardExpander>
                <ui:CardExpander x:Name="ReaderSettingsExpander"
                                  Margin="0,8,0,0"
                                  Icon="{ui:SymbolIcon Library24}">
                  <StackPanel>
                    <ui:TextBlock x:Name="ReaderPackagesPathLabel"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock x:Name="ReaderPackagesPathText"
                                  Margin="0,4,0,8"
                                  TextWrapping="Wrap"
                                  Style="{StaticResource WorkspaceMutedText}" />
                    <ui:TextBlock x:Name="ActiveReaderPackageLabel"
                                  Margin="0,0,0,4" />
                    <ComboBox x:Name="ActiveReaderPackageCombo"
                              MinHeight="32"
                              SelectionChanged="ActiveReaderPackageCombo_OnChanged" />
                    <ui:TextBlock x:Name="ReaderRestartHint"
                                  Margin="0,8,0,0"
                                  TextWrapping="Wrap"
                                  Style="{StaticResource WorkspaceMutedText}" />
                  </StackPanel>
                </ui:CardExpander>
                <ui:CardExpander x:Name="MockSettingsExpander"
                                  Margin="0,8,0,0"
                                  Visibility="Collapsed"
                                  Icon="{ui:SymbolIcon Beaker24}">
                  <StackPanel>
                    <ui:TextBlock x:Name="DatasetLabel" Margin="0,0,0,4" />
                    <ComboBox x:Name="DatasetCombo"
                              Margin="0,0,0,12"
                              MinHeight="32"
                              SelectionChanged="DatasetCombo_OnChanged" />
                    <ui:TextBlock x:Name="ErrorInjectionLabel" Margin="0,0,0,4" />
                    <ComboBox x:Name="ErrorInjectionCombo"
                              MinHeight="32"
                              SelectionChanged="ErrorInjectionCombo_OnChanged" />
                  </StackPanel>
                </ui:CardExpander>
              </StackPanel>
            </ScrollViewer>
          </ui:Card>
        </Popup>
      </Grid>
    </ui:Card>
  </Grid>
</ui:FluentWindow>
