<ui:FluentWindow x:Class="osu.EzRealmSync.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Ez Realm Sync"
                 Width="1280"
                 Height="720"
                 MinWidth="960"
                 MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 Background="Transparent"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="48" />
      <RowDefinition Height="44" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
                 Title="{Binding WindowTitle}"
                 Margin="8,6,8,0" />

    <Border Grid.Row="1" Padding="16,10" Background="{StaticResource EzBrushBgCard}" BorderBrush="{StaticResource EzBrushBorder}" BorderThickness="1" CornerRadius="8" Margin="12,6,12,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="128" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LabelEndpointA" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource EzBrushFgMuted}" />
        <TextBox x:Name="PathA" Grid.Row="0" Grid.Column="1" Margin="8,4" />
        <ui:Button x:Name="BrowseAButton" Grid.Row="0" Grid.Column="2" Margin="4,4" Click="BrowseA_OnClick" />
        <ui:Button x:Name="ScanButton" Grid.Row="0" Grid.Column="3" Margin="4,4" Click="Scan_OnClick" Appearance="Primary" />
        <TextBlock x:Name="LabelEndpointB" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource EzBrushFgMuted}" />
        <TextBox x:Name="PathB" Grid.Row="1" Grid.Column="1" Margin="8,4" />
        <ui:Button x:Name="BrowseBButton" Grid.Row="1" Grid.Column="2" Margin="4,4" Click="BrowseB_OnClick" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="16,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource EzBrushBgPanel}" CornerRadius="10" Padding="14" Margin="0,0,10,0"
              BorderBrush="{StaticResource EzBrushBorder}" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="LabelSyncDirection" FontWeight="SemiBold" Margin="0,0,0,10" />
          <RadioButton x:Name="DirectionAToB" GroupName="Direction" Checked="Direction_OnChecked" />
          <RadioButton x:Name="DirectionBToA" GroupName="Direction" Checked="Direction_OnChecked" />
          <TextBlock x:Name="LabelEntityFilter" FontWeight="SemiBold" Margin="0,18,0,8" />
          <ComboBox x:Name="EntityFilterCombo" SelectionChanged="EntityFilter_OnChanged" />
          <TextBlock x:Name="CollectionsPhase2Text" Foreground="{StaticResource EzBrushFgMuted}" FontSize="12" Margin="0,12,0,0" Opacity="0.7" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource EzBrushBgPanel}" CornerRadius="10" Padding="12"
              BorderBrush="{StaticResource EzBrushBorder}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <ui:Button x:Name="TabSourceOnly" Margin="0,0,8,6" Click="TabSourceOnly_OnClick" />
            <ui:Button x:Name="TabTargetOnly" Margin="0,0,8,6" Click="TabTargetOnly_OnClick" />
            <ui:Button x:Name="TabConflicted" Margin="0,0,8,6" Click="TabConflicted_OnClick" />
            <ui:Button x:Name="SelectAllButton" Margin="0,0,0,6" Click="SelectAll_OnClick" />
          </WrapPanel>
          <DataGrid x:Name="DiffGrid" Grid.Row="1"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Extended"
                    CurrentCellChanged="DiffGrid_OnCellChanged" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Margin="16,0" Padding="0,4" BorderBrush="{StaticResource EzBrushBorder}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="160" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SelectionCountText" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource EzBrushFgMuted}" />
        <ui:Button x:Name="SettingsButton" Grid.Column="1" Click="SettingsButton_OnClick" />
        <ui:Button x:Name="ExportButton" Grid.Column="3" IsEnabled="False" Opacity="0.35" />
        <ui:Button x:Name="DeleteButton" Grid.Column="5" Click="Delete_OnClick" />
        <ui:Button x:Name="ApplyButton" Grid.Column="7" Click="Apply_OnClick" Appearance="Primary" />
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="16,0,16,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ProgressBar x:Name="ProgressBar" Grid.Column="0" Maximum="1" VerticalAlignment="Center" />
      <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource EzBrushFgMuted}" />
    </Grid>
  </Grid>
</ui:FluentWindow>
