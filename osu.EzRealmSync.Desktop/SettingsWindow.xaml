<ui:FluentWindow x:Class="osu.EzRealmSync.Desktop.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings"
                 Width="520"
                 Height="420"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 Background="Transparent"
                 WindowBackdropType="Acrylic"
                 ExtendsContentIntoTitleBar="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" x:Name="SettingsTitleBar" Margin="6,6,6,0" />

    <ui:Card Grid.Row="1" Margin="16,8,16,16" Padding="20">
      <StackPanel>
        <ui:TextBlock x:Name="TitleLabel" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
        <ui:TextBlock x:Name="LanguageLabel" Opacity="0.75" Margin="0,0,0,4" />
        <ComboBox x:Name="LanguageCombo" Margin="0,0,0,16" SelectionChanged="LanguageCombo_OnChanged" />
        <ui:ToggleSwitch x:Name="UiTestModeSwitch" Margin="0,0,0,8" LabelPosition="Right" IsEnabled="False" />
        <ui:TextBlock x:Name="UiTestHint" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,16" />
        <ui:TextBlock x:Name="MockOptionsLabel" FontWeight="SemiBold" Margin="0,0,0,8" Visibility="Collapsed" />
        <ui:TextBlock x:Name="DatasetLabel" Opacity="0.75" Visibility="Collapsed" />
        <ComboBox x:Name="DatasetCombo" Margin="0,4,0,12" Visibility="Collapsed" SelectionChanged="DatasetCombo_OnChanged" />
        <ui:TextBlock x:Name="ErrorInjectionLabel" Opacity="0.75" Visibility="Collapsed" />
        <ComboBox x:Name="ErrorInjectionCombo" Margin="0,4,0,16" Visibility="Collapsed" SelectionChanged="ErrorInjectionCombo_OnChanged" />
        <ui:Button x:Name="CloseButton" HorizontalAlignment="Right" Padding="24,8" Click="CloseButton_OnClick" Appearance="Primary" />
      </StackPanel>
    </ui:Card>
  </Grid>
</ui:FluentWindow>
