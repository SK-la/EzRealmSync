<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="EzBgRoot">#191923</Color>
  <Color x:Key="EzBgPanel">#AA242436</Color>
  <Color x:Key="EzBgCard">#88222233</Color>
  <Color x:Key="EzBgInput">#CC2A2A3A</Color>
  <Color x:Key="EzBgToolbar">#66191923</Color>
  <Color x:Key="EzFgPrimary">#FFFFFF</Color>
  <Color x:Key="EzFgMuted">#B4B4BE</Color>
  <Color x:Key="EzAccent">#FF66AB</Color>
  <Color x:Key="EzAccentSecondary">#79A3FF</Color>
  <Color x:Key="EzRowAlt">#1C1C28</Color>
  <Color x:Key="EzBorder">#3A3A4A</Color>

  <SolidColorBrush x:Key="EzBrushBgRoot" Color="{StaticResource EzBgRoot}" />
  <SolidColorBrush x:Key="EzBrushBgToolbar" Color="{StaticResource EzBgToolbar}" />
  <SolidColorBrush x:Key="EzBrushBgPanel" Color="{StaticResource EzBgPanel}" />
  <SolidColorBrush x:Key="EzBrushBgCard" Color="{StaticResource EzBgCard}" />
  <SolidColorBrush x:Key="EzBrushBgInput" Color="{StaticResource EzBgInput}" />
  <SolidColorBrush x:Key="EzBrushFgPrimary" Color="{StaticResource EzFgPrimary}" />
  <SolidColorBrush x:Key="EzBrushFgMuted" Color="{StaticResource EzFgMuted}" />
  <SolidColorBrush x:Key="EzBrushAccent" Color="{StaticResource EzAccent}" />
  <SolidColorBrush x:Key="EzBrushRowAlt" Color="{StaticResource EzRowAlt}" />
  <SolidColorBrush x:Key="EzBrushBorder" Color="{StaticResource EzBorder}" />

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource EzBrushBgInput}" />
    <Setter Property="Foreground" Value="{StaticResource EzBrushFgPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource EzBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{StaticResource EzBrushFgPrimary}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource EzBrushBgInput}" />
    <Setter Property="Foreground" Value="{StaticResource EzBrushFgPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource EzBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource EzBrushFgPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource EzBrushBorder}" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="AlternatingRowBackground" Value="{StaticResource EzBrushRowAlt}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource EzBrushBorder}" />
    <Setter Property="HeadersVisibility" Value="Column" />
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource EzBrushBgInput}" />
    <Setter Property="Foreground" Value="{StaticResource EzBrushFgMuted}" />
    <Setter Property="BorderBrush" Value="{StaticResource EzBrushBorder}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource EzBrushFgPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource EzBrushBorder}" />
    <Setter Property="Padding" Value="6,4" />
  </Style>

  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource EzBrushFgPrimary}" />
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource EzBrushAccent}" />
    <Setter Property="Background" Value="{StaticResource EzBrushBgInput}" />
    <Setter Property="Height" Value="8" />
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource EzBrushFgPrimary}" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource EzBrushFgPrimary}" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

</ResourceDictionary>
