<Application x:Class="osu.EzRealmSync.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Themes/DarkTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="AppFont">Microsoft YaHei UI, Segoe UI</FontFamily>
      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Foreground" Value="{StaticResource EzBrushFgPrimary}" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      </Style>
      <Style TargetType="ui:Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
