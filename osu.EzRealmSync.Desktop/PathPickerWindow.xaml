<ui:FluentWindow x:Class="osu.EzRealmSync.Desktop.PathPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Select path"
                 Width="880"
                 Height="560"
                 MinWidth="640"
                 MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 Background="Transparent"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
  <Grid Margin="0,0,0,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="280" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" x:Name="PickerTitleBar" Margin="6,6,6,0" />

    <ui:Card Grid.Row="1" Margin="16,8,16,8" Padding="12,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
          <ui:Button x:Name="UpButton"
                     Margin="0,0,8,0"
                     Click="UpButton_OnClick"
                     Icon="{ui:SymbolIcon ChevronUp24}" />
          <ui:Button x:Name="RefreshButton"
                     Margin="0,0,8,0"
                     Click="RefreshButton_OnClick"
                     Icon="{ui:SymbolIcon ArrowSync24}" />
        </WrapPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox x:Name="PathBox"
                      MinHeight="36"
                      VerticalContentAlignment="Center"
                      Icon="{ui:SymbolIcon Folder24}"
                      KeyDown="PathBox_OnKeyDown" />
          <ui:Button x:Name="GoButton"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     MinHeight="36"
                     Click="GoButton_OnClick"
                     Appearance="Secondary"
                     Icon="{ui:SymbolIcon ArrowRight24}" />
        </Grid>
      </Grid>
    </ui:Card>

    <ui:Card Grid.Row="2" Margin="16,0,16,8" Padding="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200" MinWidth="160" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Padding="8">
          <DockPanel LastChildFill="True">
            <ui:TextBlock x:Name="PlacesLabel"
                          DockPanel.Dock="Top"
                          Margin="4,4,4,8"
                          FontWeight="SemiBold"
                          Opacity="0.8" />
            <ui:ListView x:Name="PlacesList"
                         BorderThickness="0"
                         SelectionChanged="PlacesList_OnSelectionChanged" />
          </DockPanel>
        </Border>

        <DockPanel Grid.Column="2" LastChildFill="True">
          <ui:BreadcrumbBar x:Name="PathBreadcrumb"
                            DockPanel.Dock="Top"
                            Margin="8,8,8,4"
                            ItemClicked="PathBreadcrumb_OnItemClicked">
            <ui:BreadcrumbBar.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ui:BreadcrumbBar.ItemTemplate>
          </ui:BreadcrumbBar>
          <ui:ListView x:Name="EntryList"
                       Margin="4,0,4,4"
                       BorderThickness="0"
                       MouseDoubleClick="EntryList_OnMouseDoubleClick"
                       SelectionChanged="EntryList_OnSelectionChanged">
            <ui:ListView.View>
              <GridView>
                <GridViewColumn x:Name="NameColumn" Width="280" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn x:Name="TypeColumn" Width="100" DisplayMemberBinding="{Binding TypeLabel}" />
                <GridViewColumn x:Name="ModifiedColumn" Width="140" DisplayMemberBinding="{Binding ModifiedLabel}" />
                <GridViewColumn x:Name="SizeColumn" Width="80" DisplayMemberBinding="{Binding SizeLabel}" />
              </GridView>
            </ui:ListView.View>
          </ui:ListView>
        </DockPanel>
      </Grid>
    </ui:Card>

    <ui:Card Grid.Row="3" Margin="16,0,16,0" Padding="12,10">
      <Grid>
        <ui:TextBlock x:Name="SelectionHint"
                      VerticalAlignment="Center"
                      TextTrimming="CharacterEllipsis"
                      Opacity="0.75" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <ui:Button x:Name="SelectFolderButton"
                     Margin="0,0,8,0"
                     MinHeight="36"
                     Click="SelectFolderButton_OnClick"
                     Icon="{ui:SymbolIcon Folder24}" />
          <ui:Button x:Name="CancelButton"
                     Margin="0,0,8,0"
                     MinHeight="36"
                     Click="CancelButton_OnClick" />
          <ui:Button x:Name="SelectButton"
                     MinHeight="36"
                     Appearance="Primary"
                     Click="SelectButton_OnClick"
                     Icon="{ui:SymbolIcon Checkmark24}" />
        </StackPanel>
      </Grid>
    </ui:Card>
  </Grid>
</ui:FluentWindow>
