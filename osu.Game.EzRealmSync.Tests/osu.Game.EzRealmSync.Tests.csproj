<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseLocalOsuLibs Condition="'$(UseLocalOsuLibs)' == ''">false</UseLocalOsuLibs>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>osu.Game.EzRealmSync.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalOsuLibs)' == 'true'">
    <Reference Include="$(EzRealmSyncLibDir)\osu.Game.dll">
      <HintPath>$(EzRealmSyncLibDir)\osu.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Realm" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalOsuLibs)' != 'true'">
    <PackageReference Include="ez2lazer.Game" />
    <PackageReference Include="Realm" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\osu.Game.EzRealmSync.Contracts\osu.Game.EzRealmSync.Contracts.csproj" />
    <ProjectReference Include="..\osu.Game.EzRealmSync\osu.Game.EzRealmSync.csproj">
      <AdditionalProperties>UseLocalOsuLibs=$(UseLocalOsuLibs)</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\osu.EzRealmSync.AppModel\osu.EzRealmSync.AppModel.csproj">
      <AdditionalProperties>UseLocalOsuLibs=$(UseLocalOsuLibs)</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\osu.Game.EzRealmSync.OfficialWrite\osu.Game.EzRealmSync.OfficialWrite.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <!-- DllVerifier 是唯一引用**真实官方包**的工程，与 Ez 线的 osu.Game 同名，只能进程外跑：
         这里借它的构建产物（不引用其类型），路径由 OfficialDllVerifierProcess 解析。 -->
    <ProjectReference Include="..\osu.Game.EzRealmSync.DllVerifier\osu.Game.EzRealmSync.DllVerifier.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="TestResources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
