<!--
  中央包版本（CPM）。Dependabot 每日检查 master，两组 PR：
  - ez2lazer：Framework / Game，CI 通过即合
  - other-nuget：其余包同 PR，CI 通过即合
  Game.Resources 仅用于压掉 ez2lazer.Game 的传递依赖，不参与更新。
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ez2lazer.Framework" Version="2026.815.0-ez2lazer" />
    <PackageVersion Include="ez2lazer.Game" Version="2026.822.0-ez2lazer" />
    <PackageVersion Include="ez2lazer.Game.Resources" Version="2026.815.0-ez2lazer" />
    <PackageVersion Include="Realm" Version="20.1.0" />
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <PackageVersion Include="WPF-UI.Abstractions" Version="4.3.0" />
    <PackageVersion Include="WPF-UI.DependencyInjection" Version="4.3.0" />
    <PackageVersion Include="WPF-UI.Markdown" Version="4.0.2" />
    <PackageVersion Include="WPF-UI.Tray" Version="4.3.0" />
    <PackageVersion Include="WPF-UI.Violeta" Version="4.3.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>
</Project>