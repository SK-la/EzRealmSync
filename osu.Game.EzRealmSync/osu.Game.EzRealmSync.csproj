<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>osu.Game.EzRealmSync</RootNamespace>
    <Description>Ez Realm 同步契约与引擎；默认 ez2lazer.Game NuGet，本地 lib/ 需 -p:UseLocalOsuLibs=true。</Description>
    <CopyLocalLockFileAssemblies Condition="'$(UseLocalOsuLibs)' == 'true'">false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="osu.Game.EzRealmSync.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\osu.Game.EzRealmSync.Contracts\osu.Game.EzRealmSync.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 官方 mod 名录：纯数据随包发布，产品进程不加载 osu.Game.dll（见 OfficialModCatalog）。 -->
    <EmbeddedResource Include="Realm\OfficialModList.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalOsuLibs)' != 'true'">
    <PackageReference Include="ez2lazer.Framework" />
    <PackageReference Include="Realm" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalOsuLibs)' == 'true'">
    <PackageReference Include="Realm" />
  </ItemGroup>
</Project>
