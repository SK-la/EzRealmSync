<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>osu.Game.EzRealmSync</RootNamespace>
    <Description>Ez Realm 同步契约与引擎；优先使用 ez2lazer.Game NuGet，回退 lib/osu.Game.dll。</Description>
    <CopyLocalLockFileAssemblies Condition="'$(UseLocalOsuLibs)' == 'true'">false</CopyLocalLockFileAssemblies>
    <UseLocalOsuLibs Condition="'$(UseLocalOsuLibs)' != 'true' and '$(UseLocalOsuLibs)' != 'false' and Exists('$(EzRealmSyncLibDir)\osu.Game.dll')">true</UseLocalOsuLibs>
  </PropertyGroup>

  <!-- NuGet 模式（默认优先）：使用 ez2lazer.Game NuGet 包提供 RealmAccess / Ez 表 -->
  <ItemGroup Condition="'$(UseLocalOsuLibs)' != 'true'">
    <PackageReference Include="ez2lazer.Framework" Version="2026.616.0-ez2lazer" />
    <PackageReference Include="ez2lazer.Game" Version="2026.621.0-ez2lazer" />
    <PackageReference Include="Realm" Version="20.1.0" />
  </ItemGroup>

  <!-- lib 回退模式：lib/*.dll 提供所有类型；仅需 Realm NuGet 供 Fody 织入 -->
  <ItemGroup Condition="'$(UseLocalOsuLibs)' == 'true'">
    <PackageReference Include="Realm" Version="20.1.0" />
  </ItemGroup>
</Project>
