<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    默认 NuGet（ez2lazer.Game）。本地 lib/ 仅作开发覆盖：-p:UseLocalOsuLibs=true
    见 lib/README.md
  -->
  <PropertyGroup>
    <EzRealmSyncLibDir>$(MSBuildThisFileDirectory)lib</EzRealmSyncLibDir>
    <UseLocalOsuLibs Condition="'$(UseLocalOsuLibs)' == ''">false</UseLocalOsuLibs>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'osu.Game.EzRealmSync' Or '$(MSBuildProjectName)' == 'osu.Game.EzRealmSync.Tests'">
    <DefineConstants>$(DefineConstants);HAS_EZ_OSU_GAME</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(EzRealmSyncLibDir)\osu.Game.dll') AND '$(UseLocalOsuLibs)' == 'true'">
    <EzRealmSyncRuntimeLib Include="$(EzRealmSyncLibDir)\*.dll"
                          Exclude="$(EzRealmSyncLibDir)\*Game.Resources*.dll;$(EzRealmSyncLibDir)\*Resources.dll" />
    <EzRealmSyncRuntimeNative Include="$(EzRealmSyncLibDir)\runtimes\**\*.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalOsuLibs)' == 'true' AND '$(MSBuildProjectName)' == 'osu.Game.EzRealmSync'">
    <EzRealmSyncLibDll Include="@(EzRealmSyncRuntimeLib)" />
    <Reference Include="@(EzRealmSyncLibDll)">
      <HintPath>%(Identity)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
