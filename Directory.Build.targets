<Project>
  <Target Name="WarnIfLibPresentButIgnored"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'osu.Game.EzRealmSync' and Exists('$(EzRealmSyncLibDir)\osu.Game.dll') and '$(UseLocalOsuLibs)' != 'true'">
    <Message Importance="high" Text="lib/osu.Game.dll 存在但已忽略（默认 NuGet）。本地覆盖请 -p:UseLocalOsuLibs=true" />
  </Target>

  <!-- 测试项目在 UseLocalOsuLibs 时复制 lib 依赖到输出目录（dotnet test 需能加载 osu.Game） -->
  <Target Name="CopyEzRealmSyncLibsForTests"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'osu.Game.EzRealmSync.Tests' AND '$(UseLocalOsuLibs)' == 'true' AND '@(EzRealmSyncRuntimeLib)' != ''">
    <Copy SourceFiles="@(EzRealmSyncRuntimeLib)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(EzRealmSyncRuntimeNative)"
          DestinationFiles="@(EzRealmSyncRuntimeNative->'$(OutputPath)runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(EzRealmSyncRuntimeNative)' != ''" />
  </Target>

  <!-- 构建 WinExe 时把 lib/*.dll 与引擎程序集复制到输出目录 -->
  <PropertyGroup>
    <OfficialWriteOutputDir>$(MSBuildThisFileDirectory)osu.Game.EzRealmSync.OfficialWrite\bin\$(Configuration)\net8.0</OfficialWriteOutputDir>
    <ReadSidecarOutputDir>$(MSBuildThisFileDirectory)osu.Game.EzRealmSync.ReadSidecar\bin\$(Configuration)\net8.0</ReadSidecarOutputDir>
  </PropertyGroup>

  <Target Name="CopyOfficialWriteWorkerToOutput"
          AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(OutputType)' == 'WinExe'">
    <ItemGroup>
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.exe" Condition="Exists('$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.exe')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.dll" Condition="Exists('$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.dll')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.deps.json" Condition="Exists('$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.deps.json')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.runtimeconfig.json" Condition="Exists('$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.runtimeconfig.json')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\osu.Game.EzRealmSync.OfficialSchema.dll" Condition="Exists('$(OfficialWriteOutputDir)\osu.Game.EzRealmSync.OfficialSchema.dll')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\osu.Game.EzRealmSync.Contracts.dll" Condition="Exists('$(OfficialWriteOutputDir)\osu.Game.EzRealmSync.Contracts.dll')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\Realm.dll" Condition="Exists('$(OfficialWriteOutputDir)\Realm.dll')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\MongoDB.Bson.dll" Condition="Exists('$(OfficialWriteOutputDir)\MongoDB.Bson.dll')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\Remotion.Linq.dll" Condition="Exists('$(OfficialWriteOutputDir)\Remotion.Linq.dll')" />
      <_OfficialWriteRuntime Include="$(OfficialWriteOutputDir)\runtimes\**\*.*" Condition="Exists('$(OfficialWriteOutputDir)\runtimes')" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)official-write" Condition="@(_OfficialWriteCopy->Count()) != 0" />
    <Copy SourceFiles="@(_OfficialWriteCopy)"
          DestinationFolder="$(OutputPath)official-write"
          SkipUnchangedFiles="true"
          Condition="@(_OfficialWriteCopy->Count()) != 0" />
    <Copy SourceFiles="@(_OfficialWriteRuntime)"
          DestinationFiles="@(_OfficialWriteRuntime->'$(OutputPath)official-write\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_OfficialWriteRuntime)' != ''" />
  </Target>

  <Target Name="CopyReadSidecarWorkerToOutput"
          AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(OutputType)' == 'WinExe'">
    <ItemGroup>
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.exe" Condition="Exists('$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.exe')" />
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.dll" Condition="Exists('$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.dll')" />
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.deps.json" Condition="Exists('$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.deps.json')" />
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.runtimeconfig.json" Condition="Exists('$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.runtimeconfig.json')" />
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\osu.Game.EzRealmSync.dll" Condition="Exists('$(ReadSidecarOutputDir)\osu.Game.EzRealmSync.dll')" />
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\osu.Game.EzRealmSync.Contracts.dll" Condition="Exists('$(ReadSidecarOutputDir)\osu.Game.EzRealmSync.Contracts.dll')" />
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\Realm.dll" Condition="Exists('$(ReadSidecarOutputDir)\Realm.dll')" />
      <_ReadSidecarRuntime Include="$(ReadSidecarOutputDir)\runtimes\**\*.*" Condition="Exists('$(ReadSidecarOutputDir)\runtimes')" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)read-sidecar" Condition="@(_ReadSidecarCopy->Count()) != 0" />
    <Copy SourceFiles="@(_ReadSidecarCopy)"
          DestinationFolder="$(OutputPath)read-sidecar"
          SkipUnchangedFiles="true"
          Condition="@(_ReadSidecarCopy->Count()) != 0" />
    <Copy SourceFiles="@(_ReadSidecarRuntime)"
          DestinationFiles="@(_ReadSidecarRuntime->'$(OutputPath)read-sidecar\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_ReadSidecarRuntime)' != ''" />
  </Target>

  <Target Name="CopyReadSidecarWorkerToTestOutput"
          AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(MSBuildProjectName)' == 'osu.Game.EzRealmSync.Tests'">
    <ItemGroup>
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.exe" Condition="Exists('$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.exe')" />
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.dll" Condition="Exists('$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.dll')" />
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.deps.json" Condition="Exists('$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.deps.json')" />
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.runtimeconfig.json" Condition="Exists('$(ReadSidecarOutputDir)\EzRealmSync.ReadSidecar.runtimeconfig.json')" />
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\osu.Game.EzRealmSync.dll" Condition="Exists('$(ReadSidecarOutputDir)\osu.Game.EzRealmSync.dll')" />
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\osu.Game.EzRealmSync.Contracts.dll" Condition="Exists('$(ReadSidecarOutputDir)\osu.Game.EzRealmSync.Contracts.dll')" />
      <_ReadSidecarCopy Include="$(ReadSidecarOutputDir)\Realm.dll" Condition="Exists('$(ReadSidecarOutputDir)\Realm.dll')" />
      <_ReadSidecarRuntime Include="$(ReadSidecarOutputDir)\runtimes\**\*.*" Condition="Exists('$(ReadSidecarOutputDir)\runtimes')" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)read-sidecar" Condition="@(_ReadSidecarCopy->Count()) != 0" />
    <Copy SourceFiles="@(_ReadSidecarCopy)"
          DestinationFolder="$(OutputPath)read-sidecar"
          SkipUnchangedFiles="true"
          Condition="@(_ReadSidecarCopy->Count()) != 0" />
    <Copy SourceFiles="@(_ReadSidecarRuntime)"
          DestinationFiles="@(_ReadSidecarRuntime->'$(OutputPath)read-sidecar\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_ReadSidecarRuntime)' != ''" />
  </Target>

  <Target Name="CopyReadersFolderToOutput"
          AfterTargets="Build"
          Condition="'$(OutputType)' == 'WinExe'">
    <ItemGroup>
      <_ReadersContent Include="$(MSBuildThisFileDirectory)readers\**\*.*"
                       Exclude="$(MSBuildThisFileDirectory)readers\**\lib\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ReadersContent)"
          DestinationFiles="@(_ReadersContent->'$(OutputPath)readers\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_ReadersContent)' != ''" />
  </Target>

  <Target Name="CopyReadersFolderToTestOutput"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'osu.Game.EzRealmSync.Tests'">
    <ItemGroup>
      <_ReadersContent Include="$(MSBuildThisFileDirectory)readers\**\*.*"
                       Exclude="$(MSBuildThisFileDirectory)readers\**\lib\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ReadersContent)"
          DestinationFiles="@(_ReadersContent->'$(OutputPath)readers\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_ReadersContent)' != ''" />
  </Target>

  <Target Name="CopyOfficialWriteWorkerToTestOutput"
          AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(MSBuildProjectName)' == 'osu.Game.EzRealmSync.Tests'">
    <ItemGroup>
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.exe" Condition="Exists('$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.exe')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.dll" Condition="Exists('$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.dll')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.deps.json" Condition="Exists('$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.deps.json')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.runtimeconfig.json" Condition="Exists('$(OfficialWriteOutputDir)\EzRealmSync.OfficialWrite.runtimeconfig.json')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\osu.Game.EzRealmSync.OfficialSchema.dll" Condition="Exists('$(OfficialWriteOutputDir)\osu.Game.EzRealmSync.OfficialSchema.dll')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\osu.Game.EzRealmSync.Contracts.dll" Condition="Exists('$(OfficialWriteOutputDir)\osu.Game.EzRealmSync.Contracts.dll')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\Realm.dll" Condition="Exists('$(OfficialWriteOutputDir)\Realm.dll')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\MongoDB.Bson.dll" Condition="Exists('$(OfficialWriteOutputDir)\MongoDB.Bson.dll')" />
      <_OfficialWriteCopy Include="$(OfficialWriteOutputDir)\Remotion.Linq.dll" Condition="Exists('$(OfficialWriteOutputDir)\Remotion.Linq.dll')" />
      <_OfficialWriteRuntime Include="$(OfficialWriteOutputDir)\runtimes\**\*.*" Condition="Exists('$(OfficialWriteOutputDir)\runtimes')" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)official-write" Condition="@(_OfficialWriteCopy->Count()) != 0" />
    <Copy SourceFiles="@(_OfficialWriteCopy)"
          DestinationFolder="$(OutputPath)official-write"
          SkipUnchangedFiles="true"
          Condition="@(_OfficialWriteCopy->Count()) != 0" />
    <Copy SourceFiles="@(_OfficialWriteRuntime)"
          DestinationFiles="@(_OfficialWriteRuntime->'$(OutputPath)official-write\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_OfficialWriteRuntime)' != ''" />
  </Target>

  <ItemGroup Condition="'$(UseLocalOsuLibs)' == 'true'">
    <EzRealmSyncEngineOutput Include="$(MSBuildThisFileDirectory)osu.Game.EzRealmSync\bin\$(Configuration)\net8.0\osu.Game.EzRealmSync.dll" />
  </ItemGroup>

  <Target Name="CopyEzRealmSyncLibsToOutput"
          AfterTargets="Build"
          Condition="'$(OutputType)' == 'WinExe' AND '$(UseLocalOsuLibs)' == 'true' AND ('@(EzRealmSyncRuntimeLib)' != '' OR '@(EzRealmSyncEngineOutput)' != '')">
    <MakeDir Directories="$(OutputPath)lib" />
    <ItemGroup>
      <_EzCopyToLib Include="@(EzRealmSyncRuntimeLib)" />
      <_EzCopyToExe Include="@(EzRealmSyncEngineOutput)" />
    </ItemGroup>
    <Message Importance="high" Text="CopyEzRealmSyncLibs -> $(OutputPath)lib: @(_EzCopyToLib->'%(Filename)%(Extension)', ', ')" />
    <Copy SourceFiles="@(_EzCopyToLib)"
          DestinationFolder="$(OutputPath)lib"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(EzRealmSyncRuntimeNative)"
          DestinationFiles="@(EzRealmSyncRuntimeNative->'$(OutputPath)lib\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false"
          Condition="'@(EzRealmSyncRuntimeNative)' != ''" />
    <Copy SourceFiles="@(_EzCopyToExe)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="false"
          Condition="'@(_EzCopyToExe)' != ''" />
  </Target>

  <!-- 无构建 lib 时也创建运行时 lib 目录，便于用户手动放置 DLL -->
  <Target Name="EnsureRuntimeLibFolder"
          AfterTargets="Build"
          Condition="'$(OutputType)' == 'WinExe'">
    <MakeDir Directories="$(OutputPath)lib" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)lib\README.md"
          DestinationFiles="$(OutputPath)lib\README.md"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)lib\README.md')" />
  </Target>

  <!-- WPF MarkupCompile 需要能解析 osu.Game.EzRealmSync 的传递依赖（如 Realm.dll） -->
  <Target Name="StageEzRealmDepsForWpfMarkup"
          BeforeTargets="MarkupCompilePass1"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(OutputType)' == 'WinExe' AND '$(UseLocalOsuLibs)' == 'true'">
    <ItemGroup>
      <_WpfStageDll Include="$(MSBuildThisFileDirectory)osu.Game.EzRealmSync\bin\$(Configuration)\net8.0\osu.Game.EzRealmSync.dll" />
      <_WpfStageDll Include="$(EzRealmSyncLibDir)\Realm.dll" Condition="Exists('$(EzRealmSyncLibDir)\Realm.dll')" />
      <_WpfStageDll Include="$(EzRealmSyncLibDir)\osu.Game.dll" Condition="Exists('$(EzRealmSyncLibDir)\osu.Game.dll')" />
      <_WpfStageDll Include="$(EzRealmSyncLibDir)\osu.Framework.dll" Condition="Exists('$(EzRealmSyncLibDir)\osu.Framework.dll')" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)" Condition="!Exists('$(OutputPath)')" />
    <Copy SourceFiles="@(_WpfStageDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyEzRealmSyncLibsToPublish"
          AfterTargets="Publish"
          Condition="'$(OutputType)' == 'WinExe' AND '$(UseLocalOsuLibs)' == 'true'">
    <MakeDir Directories="$(PublishDir)lib" />
    <Copy SourceFiles="@(EzRealmSyncRuntimeLib)"
          DestinationFolder="$(PublishDir)lib"
          SkipUnchangedFiles="false"
          Condition="'@(EzRealmSyncRuntimeLib)' != ''" />
    <Copy SourceFiles="@(EzRealmSyncRuntimeNative)"
          DestinationFiles="@(EzRealmSyncRuntimeNative->'$(PublishDir)lib\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false"
          Condition="'@(EzRealmSyncRuntimeNative)' != ''" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)lib\README.md"
          DestinationFiles="$(PublishDir)lib\README.md"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)lib\README.md')" />
  </Target>

  <!-- dotnet build -t:SyncReaderLibs EzRealmSync.sln -->
  <Target Name="SyncReaderLibs"
          Condition="'$(MSBuildProjectName)' == 'osu.EzRealmSync.Desktop'">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Sync-ReaderLibs.ps1&quot;"
          IgnoreExitCode="false" />
  </Target>

  <!-- dotnet build -t:SyncEzRealmLibs EzRealmSync.sln -->
  <PropertyGroup>
    <EzOsuGameProject>$(MSBuildThisFileDirectory)..\osu\osu.Game\osu.Game.csproj</EzOsuGameProject>
    <EzOsuGamePublishStagingDir>$(MSBuildThisFileDirectory)obj\SyncEzRealmLibs\$(Configuration)\net8.0</EzOsuGamePublishStagingDir>
  </PropertyGroup>

  <Target Name="SyncEzRealmLibs"
          Condition="'$(MSBuildProjectName)' == 'osu.EzRealmSync.Desktop'">
    <Message Importance="high"
             Text="SyncEzRealmLibs: publish $(EzOsuGameProject) -> $(EzRealmSyncLibDir)"
             Condition="Exists('$(EzOsuGameProject)')" />
    <Exec Command="dotnet publish &quot;$(EzOsuGameProject)&quot; -c $(Configuration) -o &quot;$(EzOsuGamePublishStagingDir)&quot;"
          Condition="Exists('$(EzOsuGameProject)')" />
    <ItemGroup Condition="Exists('$(EzOsuGamePublishStagingDir)\osu.Game.dll')">
      <_EzLibSource Include="$(EzOsuGamePublishStagingDir)\*.dll"
                    Exclude="$(EzOsuGamePublishStagingDir)\*Game.Resources*.dll;$(EzOsuGamePublishStagingDir)\*Resources.dll" />
      <_EzLibRuntime Include="$(EzOsuGamePublishStagingDir)\runtimes\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(EzRealmSyncLibDir)" Condition="Exists('$(EzOsuGamePublishStagingDir)\osu.Game.dll')" />
    <Copy SourceFiles="@(_EzLibSource)"
          DestinationFolder="$(EzRealmSyncLibDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(EzOsuGamePublishStagingDir)\osu.Game.dll')" />
    <Copy SourceFiles="@(_EzLibRuntime)"
          DestinationFiles="@(_EzLibRuntime->'$(EzRealmSyncLibDir)\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="Exists('$(EzOsuGamePublishStagingDir)\osu.Game.dll')" />
    <Message Importance="high"
             Text="SyncEzRealmLibs: copied @(_EzLibSource->Count()) DLL(s) to $(EzRealmSyncLibDir)"
             Condition="Exists('$(EzOsuGamePublishStagingDir)\osu.Game.dll')" />
    <Warning Text="SyncEzRealmLibs: publish 未产出 osu.Game.dll。请确认 ../osu 可构建: dotnet build osu.Game/osu.Game.csproj -c $(Configuration)"
             Condition="Exists('$(EzOsuGameProject)') and !Exists('$(EzOsuGamePublishStagingDir)\osu.Game.dll')" />
    <Warning Text="SyncEzRealmLibs: 未找到 $(EzOsuGameProject)"
             Condition="!Exists('$(EzOsuGameProject)')" />
  </Target>

  <!-- NuGet / 本地 lib 发布：排除 Resources 并裁剪 osu.Game 闭包内渲染/音频等 dead weight DLL -->
  <Target Name="PruneEzRealmSyncPublish"
          AfterTargets="CopyEzRealmSyncLibsToPublish;Publish"
          Condition="'$(OutputType)' == 'WinExe'">
    <PropertyGroup>
      <_EzPublishDirNormalized>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_EzPublishDirNormalized>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\prune-publish.ps1&quot; &quot;$(_EzPublishDirNormalized)&quot;"
          IgnoreExitCode="false" />
  </Target>
</Project>
